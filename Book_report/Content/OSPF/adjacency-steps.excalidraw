      "isDeleted": false,
      "boundElements": [],
      "updated": 1739796529384,
      "link": null,
      "locked": false,
      "text": "הנתבי DR ו BDR נבחרים, והיחסים\nשל ראשי ומשני ממושים בשביל\nהקצאת מספרי רצף.",
      "fontSize": 20,
      "fontFamily": 7,
      "textAlign": "right",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "הנתבי DR ו BDR נבחרים, והיחסים\nשל ראשי ומשני ממושים בשביל\nהקצאת מספרי רצף.",
      "autoResize": true,
      "lineHeight": 1.15
    },
