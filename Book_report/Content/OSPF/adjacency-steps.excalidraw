    {
      "id": "CAnv9MWz1HzmKZNmV5Wmq",
      "type": "text",
      "x": 794.0303637624424,
      "y": 778.815629962229,
      "width": 325.8114471435547,
      "height": 69,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
